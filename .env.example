# Copy to .env and adjust. Real environment variables override values in this file.
# Do not quote values: docker --env-file takes everything after '=' literally.
# The .env next to main.py is used; set OPCUA_MCP_ENV_FILE to use a different file.

# --- OPC UA connection ---
# One endpoint URL, or several separated by commas. At startup they are tried in order and
# the first reachable one is used, e.g. simulation first, then the real hardware:
#   OPCUA_SERVER_URL=opc.tcp://127.0.0.1:4840,opc.tcp://192.168.0.10:4840
# Prefer 127.0.0.1 over localhost: on Windows a stopped localhost takes twice as long to skip.
# In Docker, localhost is the container itself; use host.docker.internal for the host.
OPCUA_SERVER_URL=opc.tcp://127.0.0.1:4840
# Leave both empty for an anonymous login; set both for a username/password login.
# A username with an empty password logs in without a password (B&R: user "Anonymous").
OPCUA_USERNAME=
OPCUA_PASSWORD=
# Request timeout in seconds
OPCUA_TIMEOUT=4
# Reconnect automatically when the connection to the OPC UA server drops
OPCUA_AUTO_RECONNECT=true

# --- Certificate-based security ---
# None, Basic256Sha256, Aes128_Sha256_RsaOaep or Aes256_Sha256_RsaPss
# (B&R PLCs disable None by default; Basic256Sha256 or Aes128_Sha256_RsaOaep work there)
OPCUA_SECURITY_POLICY=None
# Sign or SignAndEncrypt
OPCUA_SECURITY_MODE=SignAndEncrypt
# Client certificate (DER or PEM) and private key. With a policy other than None, both are
# generated on first start if neither exists; the server must then trust the certificate.
# Relative paths are resolved against the directory of main.py.
# OPCUA_CLIENT_CERT=certs/client_cert.der
# OPCUA_CLIENT_KEY=certs/client_key.pem
# OPCUA_CLIENT_KEY_PASSWORD=
# Pin the server certificate; without it the certificate the server presents is accepted
# (its SHA-256 fingerprint is logged on connect)
# OPCUA_SERVER_CERT=certs/server_cert.der
# Default: the URI in the client certificate (urn:opcua-mcp:client for a generated one)
# OPCUA_APPLICATION_URI=
# DNS name written into a generated certificate
# OPCUA_CLIENT_HOSTNAME=opcua-mcp

# --- MCP transport ---
# Commented lines show the defaults. Leave them commented when using Docker:
# the image sets MCP_HOST=0.0.0.0 and MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,
# and docker-compose.yml sets MCP_TRANSPORT=streamable-http.
# stdio (MCP client starts the server), or streamable-http / sse (long-running service)
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# Comma-separated Host headers accepted over HTTP, e.g. localhost:*,127.0.0.1:*
# Empty: DNS rebinding protection is on for a loopback MCP_HOST and off otherwise.
# MCP_ALLOWED_HOSTS=
# docker compose only: host port for http://localhost:<port>/mcp
# MCP_PUBLISHED_PORT=8000

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
